<Window x:Class="WpfMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <!-- контейнер, який притискає елементи до країв вікна з відступом 10 -->
    <DockPanel Margin="10">
        <!-- вертикальна панель для кнопок -->
        <StackPanel DockPanel.Dock="Right" Width="100">
            <!-- кнопка додавання користувача -->
            <Button Name="btnAddUser" Click="btnAddUser_Click">Додати</Button>
            <!-- кнопка редагування користувача -->
            <Button Name="btnEditUser" Margin="0 10 0 0">Редагувати</Button>
        </StackPanel>

        <!-- таблиця для користувачів без автоматичного створення колонок -->
        <DataGrid Name="dgvUsers" AutoGenerateColumns="False">
            <!-- блок з описом усіх колонок таблиці -->
            <DataGrid.Columns>
                <!-- колонка зі своїм шаблоном для відображення фото -->
                <DataGridTemplateColumn Header="Фото">
                    <!-- шаблон зовнішнього вигляду однієї клітинки -->
                    <DataGridTemplateColumn.CellTemplate>
                        <!-- шаблон даних для елемента всередині клітинки -->
                        <DataTemplate>
                            <!-- картинка 50 на 100, бере посилання з поля Image -->
                            <Image Width="50" Height="100" Source="{Binding Image}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- текстова колонка для імені -->
                <DataGridTextColumn Header="Ім'я" Binding="{Binding Name}" MinWidth="200" MaxWidth="400"/>

                <!-- текстова колонка для телефону  -->
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" MinWidth="150" MaxWidth="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>